# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/status-tracker

# Tracker settings
TRACKER_INTERVAL=*/1 * * * *
TRACKER_TARGETS=[{"type":"server","url":"http://localhost:4000/health"}]
DATA_RETENTION_DAYS=7

# Discord notification settings
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_NOTIFY_USER_IDS=user_id_1,user_id_2

# Self-ping settings
SELF_PING_ENABLED=false
SELF_PING_URL=http://localhost:3000/health
SELF_PING_INTERVAL=*/5 * * * *

# Server settings
PORT=3000
