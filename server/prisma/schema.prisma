  updated_by String?
  deleted_by String?

  @@map("global_notifications")
}

model UserNotification {
  id      String           @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id String           @db.Uuid
  title   String
  content String           @db.Text
  type    NotificationType @default(INFO)
  is_read Boolean          @default(false)
  read_at DateTime?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_read])
  @@map("user_notifications")
}

model OrganizationNotification {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_id String           @db.Uuid
  warehouse_id    String?          @db.Uuid
  title           String
  content         String           @db.Text
  type            NotificationType @default(INFO)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([warehouse_id])
  @@map("organization_notifications")
}
