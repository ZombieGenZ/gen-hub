generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp")]
}

enum ProvinceType {
  CITY
  PROVINCE
}

model Province {
  id   String        @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  code String        @unique
  name String
  slug String?
  type ProvinceType?

  wards Ward[]

  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  @@map("provinces")
}

enum WardType {
  WARD
  COMMUNE
  TOWNSHIP
  TOWN
  CITY
}

model Ward {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  code        String    @unique
  name        String
  slug        String?
  type        WardType?
  province_id String    @db.Uuid

  province Province @relation(fields: [province_id], references: [id], onDelete: Cascade)

  partners           Partner[]
  warehouses         Warehouse[]
  warehouseTemplates WarehouseTemplate[]

  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  @@index([province_id])
  @@map("wards")
}

model User {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  language             String    @default("vi")
  name                 String
  email                String?
  email_confirmed      Boolean   @default(false)
  email_verify_token   String?
  email_verify_expired DateTime?
  // phone                String?
  // phone_confirmed      Boolean   @default(false)
  // phone_verify_token   String?
  // phone_verify_expired DateTime?

  is_verified             Boolean?  @default(false)
  is_banned               Boolean?  @default(false)
  is_brute_force_banned   Boolean   @default(false)
  is_ban_from_warn        Boolean   @default(false)
  banned_start            DateTime?
  banned_end              DateTime?
  two_factor_enabled      Boolean   @default(false)
  two_factor_token        String?
  password                String?
  forgot_password_token   String?
  forgot_password_expired DateTime?

  is_online   Boolean   @default(false)
  last_online DateTime?

  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?   @db.Uuid

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  refresh_tokens RefreshToken[]

  system_roles       UserRole[]
  system_permissions UserPermission[]

  created_api_keys ApiKey[]

  owned_organizations      Organization[]       @relation("OwnerRelation")
  organization_memberships OrganizationMember[]

  system_logs             SystemLog[]
  database_logs           DatabaseLog[]
  organization_audit_logs OrganizationAuditLog[]
  backupCodes             BackupCode[]
  notifications           UserNotification[]
  saved_coupons           UserSavedCoupon[]

  coupon_targets          CouponTargetUser[]
  coupon_schedule_targets CouponScheduleTargetUser[]

  organization_update_requests OrganizationUpdateRequest[] @relation("RequestByRel")

  assigned_contact_conversations ContactConversation[]      @relation("AssignedStaff")
  contact_staff_assignments      ContactConversationStaff[] @relation("ContactStaff")

  warnings UserWarning[]
  warehouse_managers WarehouseTemplateManager[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id    String    @db.Uuid
  ip         String?
  location   String?
  device     String?
  os         String?
  token      String    @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model BackupCode {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id    String    @db.Uuid
  code       String
  is_used    Boolean   @default(false)
  used_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("backup_codes")
}

model Role {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  is_active   Boolean?  @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  is_deleted  Boolean   @default(false)
  deleted_at  DateTime?

  is_default Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  key         String
  is_active   Boolean?  @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  is_deleted  Boolean   @default(false)
  deleted_at  DateTime?

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  role_id       String    @db.Uuid
  permission_id String    @db.Uuid
  is_active     Boolean?  @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@index([role_id])
  @@index([permission_id])
  @@map("roles_permissions")
}

model UserRole {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([role_id])
  @@map("users_roles")
}

model UserPermission {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id       String    @db.Uuid
  permission_id String    @db.Uuid
  is_active     Boolean?  @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([permission_id])
  @@map("users_permissions")
}

enum ContractStatus {
  PENDING
  ACTIVE
  OVERDUE_LEVEL_1
  OVERDUE_LEVEL_2
  OVERDUE_LEVEL_3
  SEALED
  LIQUIDATED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentType {
  NEW_CONTRACT
  RENEWAL
  ACCOUNT_DEPOSIT
}

enum PaymentPurpose {
  RENTAL_CONTRACT_NEW
  RENTAL_CONTRACT_RENEWAL
  ACCOUNT_DEPOSIT
}

enum BalanceTransactionType {
  DEPOSIT
  WITHDRAW
  PAYMENT
  REFUND
  ADJUSTMENT
  BONUS
}

enum BalanceReferenceType {
  PAYMENT
  RENTAL_CONTRACT
  REFUND
  MANUAL_ADJUSTMENT
}

enum DurationUnit {
  MONTH
  YEAR
}

enum BanDurationUnit {
  SECOND
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum FeatureFlagAction {
  CREATED
  ENABLED
  DISABLED
  DELETED
}

enum TemplateRentalStatus {
  AVAILABLE
  LOCKED
  RENTED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum CouponDiscountType {
  PERCENT
  AMOUNT
  FREE_MONTHS
}

enum CouponSchedulePeriod {
  YEARLY
  QUARTERLY
  MONTHLY
  WEEKLY
  DAILY
}

enum CouponDurationUnit {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum CouponType {
  PUBLIC
  PRIVATE
}

enum PaymentMethod {
  BALANCE
  TRANSFER
  HYBRID
}

enum ContractCancelType {
  CLIENT_REQUEST
  PROVIDER_REQUEST
  VIOLATION
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Amenity {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  icon        String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  warehouse_templates AmenityOnWarehouseTemplate[]

  @@map("amenities")
}

model AmenityOnWarehouseTemplate {
  id                    String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  amenity_id            String @db.Uuid
  warehouse_template_id String @db.Uuid

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  deleted_by String?

  amenity            Amenity           @relation(fields: [amenity_id], references: [id], onDelete: Cascade)
  warehouse_template WarehouseTemplate @relation(fields: [warehouse_template_id], references: [id], onDelete: Cascade)

  @@unique([amenity_id, warehouse_template_id])
  @@index([amenity_id])
  @@index([warehouse_template_id])
  @@map("amenities_warehouse_templates")
}

model WarehouseTemplate {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?

  length Int
  width  Int

  is_shared_warehouse Boolean @default(false)

  rental_status   TemplateRentalStatus @default(AVAILABLE)
  is_rented       Boolean              @default(false)
  price_per_month Decimal              @db.Decimal(19, 4)

  address_detail String?
  ward_id        String? @db.Uuid
  ward           Ward?   @relation(fields: [ward_id], references: [id])

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  block_length Decimal @db.Decimal(10, 4)
  block_width  Decimal @db.Decimal(10, 4)



  ceiling_height    Decimal? @db.Decimal(10, 4)
  max_load_capacity Decimal? @db.Decimal(19, 4)

  total_weight_capacity Decimal? @db.Decimal(19, 4)

  is_cold_storage Boolean  @default(false)
  min_temperature Decimal? @db.Decimal(5, 2)
  max_temperature Decimal? @db.Decimal(5, 2)
  min_humidity    Decimal? @db.Decimal(5, 2)
  max_humidity    Decimal? @db.Decimal(5, 2)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  rows                    RowTemplate[]
  images                  WarehouseTemplateImage[]
  amenities               AmenityOnWarehouseTemplate[]
  rental_contract_details RentalContractDetail[]
  discount_configs        WarehouseDiscountConfig[]
  addon_gifts             WarehouseAddonGift[]
  insurance_gifts         WarehouseInsuranceGift[]

  coupon_targets          CouponTargetWarehouse[]
  coupon_schedule_targets CouponScheduleTargetWarehouse[]

  managers          WarehouseTemplateManager[]
  visit_bookings    WarehouseVisitBooking[]
  generated_warehouses Warehouse[] @relation("GeneratedWarehouses")

  @@map("warehouse_templates")
}

model RentalDurationTier {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name           String
  duration_value Int
  duration_unit  DurationUnit @default(MONTH)
  description    String?
  order          Int          @default(0)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  warehouse_discount_configs WarehouseDiscountConfig[]
  row_discount_configs       RowDiscountConfig[]
  payments                   Payment[]
  tier_addon_gifts           TierAddonGift[]
  tier_insurance_gifts       TierInsuranceGift[]

  @@unique([duration_value, duration_unit])
  @@map("rental_duration_tiers")
}

model Addon {
  id                 String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name               String
  description        String?
  price              Decimal @db.Decimal(19, 4)
  is_monthly_payment Boolean @default(false)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  tier_gifts       TierAddonGift[]
  warehouse_gifts  WarehouseAddonGift[]
  row_gifts        RowAddonGift[]
  rental_contracts RentalContractAddon[]

  coupon_targets          CouponTargetAddon[]
  coupon_schedule_targets CouponScheduleTargetAddon[]

  coupon_gifts          CouponGiftAddon[]
  coupon_schedule_gifts CouponScheduleGiftAddon[]

  addon_types AddonTypeOnAddon[]

  @@map("addons")
}

model AddonType {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  addons AddonTypeOnAddon[]

  @@map("addon_types")
}

model AddonTypeOnAddon {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  addon_type_id String @db.Uuid
  addon_id      String @db.Uuid

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  deleted_by String?

  addon_type AddonType @relation(fields: [addon_type_id], references: [id], onDelete: Cascade)
  addon      Addon     @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@unique([addon_type_id, addon_id])
  @@index([addon_type_id])
  @@index([addon_id])
  @@map("addon_types_addons")
}

enum ManagementFeeType {
  PERCENT
  AMOUNT
}

model Insurance {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name                 String
  description          String?
  price                Decimal            @db.Decimal(19, 4)
  use_management_fee   Boolean            @default(false)
  management_fee_type  ManagementFeeType?
  management_fee_value Decimal?           @db.Decimal(19, 4)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  tier_gifts      TierInsuranceGift[]
  warehouse_gifts WarehouseInsuranceGift[]
  row_gifts       RowInsuranceGift[]

  coupon_gifts          CouponGiftInsurance[]
  coupon_schedule_gifts CouponScheduleGiftInsurance[]

  coupon_targets          CouponTargetInsurance[]
  coupon_schedule_targets CouponScheduleTargetInsurance[]

  rental_contract_insurances RentalContractInsurance[]

  @@map("insurances")
}

model TierInsuranceGift {
  id               String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  duration_tier_id String @db.Uuid
  insurance_id     String @db.Uuid

  require_min_order_amount Boolean  @default(false)
  min_order_amount         Decimal? @db.Decimal(19, 4)

  require_min_warehouses Boolean @default(false)
  min_warehouses         Int?

  require_min_rows Boolean @default(false)
  min_rows         Int?

  is_until_service_end Boolean       @default(true)
  gift_duration_value  Int?
  gift_duration_unit   DurationUnit?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  duration_tier RentalDurationTier @relation(fields: [duration_tier_id], references: [id], onDelete: Cascade)
  insurance     Insurance          @relation(fields: [insurance_id], references: [id], onDelete: Cascade)

  @@unique([duration_tier_id, insurance_id])
  @@index([duration_tier_id])
  @@index([insurance_id])
  @@map("tier_insurance_gifts")
}

model WarehouseInsuranceGift {
  id                    String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  warehouse_template_id String @db.Uuid
  insurance_id          String @db.Uuid

  is_until_service_end Boolean       @default(true)
  gift_duration_value  Int?
  gift_duration_unit   DurationUnit?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  warehouse_template WarehouseTemplate @relation(fields: [warehouse_template_id], references: [id], onDelete: Cascade)
  insurance          Insurance         @relation(fields: [insurance_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_template_id, insurance_id])
  @@index([warehouse_template_id])
  @@index([insurance_id])
  @@map("warehouse_insurance_gifts")
}

model RowInsuranceGift {
  id              String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  row_template_id String @db.Uuid
  insurance_id    String @db.Uuid

  is_until_service_end Boolean       @default(true)
  gift_duration_value  Int?
  gift_duration_unit   DurationUnit?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  row_template RowTemplate @relation(fields: [row_template_id], references: [id], onDelete: Cascade)
  insurance    Insurance   @relation(fields: [insurance_id], references: [id], onDelete: Cascade)

  @@unique([row_template_id, insurance_id])
  @@index([row_template_id])
  @@index([insurance_id])
  @@map("row_insurance_gifts")
}

model TierAddonGift {
  id               String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  duration_tier_id String @db.Uuid
  addon_id         String @db.Uuid

  require_min_order_amount Boolean  @default(false)
  min_order_amount         Decimal? @db.Decimal(19, 4)

  require_min_warehouses Boolean @default(false)
  min_warehouses         Int?

  require_min_rows Boolean @default(false)
  min_rows         Int?

  is_until_service_end Boolean       @default(true)
  gift_duration_value  Int?
  gift_duration_unit   DurationUnit?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  duration_tier RentalDurationTier @relation(fields: [duration_tier_id], references: [id], onDelete: Cascade)
  addon         Addon              @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@unique([duration_tier_id, addon_id])
  @@index([duration_tier_id])
  @@index([addon_id])
  @@map("tier_addon_gifts")
}

model WarehouseAddonGift {
  id                    String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  warehouse_template_id String @db.Uuid
  addon_id              String @db.Uuid

  is_until_service_end Boolean       @default(true)
  gift_duration_value  Int?
  gift_duration_unit   DurationUnit?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  warehouse_template WarehouseTemplate @relation(fields: [warehouse_template_id], references: [id], onDelete: Cascade)
  addon              Addon             @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_template_id, addon_id])
  @@index([warehouse_template_id])
  @@index([addon_id])
  @@map("warehouse_addon_gifts")
}

model RowAddonGift {
  id              String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  row_template_id String @db.Uuid
  addon_id        String @db.Uuid

  is_until_service_end Boolean       @default(true)
  gift_duration_value  Int?
  gift_duration_unit   DurationUnit?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  row_template RowTemplate @relation(fields: [row_template_id], references: [id], onDelete: Cascade)
  addon        Addon       @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@unique([row_template_id, addon_id])
  @@index([row_template_id])
  @@index([addon_id])
  @@map("row_addon_gifts")
}

model Coupon {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  code        String

  coupon_type CouponType @default(PUBLIC)

  discount_value Decimal            @db.Decimal(19, 4)
  discount_type  CouponDiscountType

  require_min_warehouses Boolean @default(false)
  min_warehouses         Int?

  require_min_rows Boolean @default(false)
  min_rows         Int?

  require_min_order_amount Boolean  @default(false)
  min_order_amount         Decimal? @db.Decimal(19, 4)

  require_min_rental_duration Boolean       @default(false)
  min_rental_duration_value   Int?
  min_rental_duration_unit    DurationUnit?

  is_unlimited_discount Boolean  @default(false)
  max_discount_amount   Decimal? @db.Decimal(19, 4)

  is_permanent Boolean   @default(false)
  starts_at    DateTime?
  ends_at      DateTime?

  max_usage     Int @default(0)
  current_usage Int @default(0)
  total_usage   Int @default(0)

  is_public              Boolean @default(false)
  apply_for_first_rental Boolean @default(true)
  apply_for_renewal      Boolean @default(true)

  apply_for_all_warehouses Boolean @default(true)
