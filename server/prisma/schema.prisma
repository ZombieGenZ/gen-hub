generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

enum ProvinceType {
  CITY
  PROVINCE
}

model Province {
  id   String        @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  code String        @unique
  name String
  slug String?
  type ProvinceType?

  wards Ward[]

  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  @@map("provinces")
}

enum WardType {
  WARD
  COMMUNE
  TOWNSHIP
  TOWN
  CITY
}

model Ward {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  code        String    @unique
  name        String
  slug        String?
  type        WardType?
  province_id String    @db.Uuid

  province Province @relation(fields: [province_id], references: [id], onDelete: Cascade)

  partners           Partner[]
  warehouses         Warehouse[]
  warehouseTemplates WarehouseTemplate[]

  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  @@index([province_id])
  @@map("wards")
}

model User {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  language             String    @default("vi")
  avatar               String?
  name                 String
  email                String?
  email_confirmed      Boolean   @default(false)
  email_verify_token   String?
  email_verify_expired DateTime?
  // phone                String?
  // phone_confirmed      Boolean   @default(false)
  // phone_verify_token   String?
  // phone_verify_expired DateTime?

  is_verified             Boolean?  @default(false)
  is_banned               Boolean?  @default(false)
  banned_end              DateTime?
  two_factor_enabled      Boolean   @default(false)
  two_factor_token        String?
  password                String?
  forgot_password_token   String?
  forgot_password_expired DateTime?

  is_online   Boolean   @default(false)
  last_online DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  refresh_tokens RefreshToken[]

  system_roles       UserRole[]
  system_permissions UserPermission[]

  created_api_keys ApiKey[]

  owned_organizations      Organization[]       @relation("OwnerRelation")
  organization_memberships OrganizationMember[]

  system_logs             SystemLog[]
  organization_audit_logs OrganizationAuditLog[]
  backupCodes             BackupCode[]
  notifications           UserNotification[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id    String    @db.Uuid
  ip         String?
  location   String?
  device     String?
  os         String?
  token      String    @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model BackupCode {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id    String    @db.Uuid
  code       String
  is_used    Boolean   @default(false)
  used_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("backup_codes")
}

model Role {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  is_active   Boolean?  @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  is_deleted  Boolean   @default(false)
  deleted_at  DateTime?

  is_default Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  key         String
  is_active   Boolean?  @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  is_deleted  Boolean   @default(false)
  deleted_at  DateTime?

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  role_id       String    @db.Uuid
  permission_id String    @db.Uuid
  is_active     Boolean?  @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@index([role_id])
  @@index([permission_id])
  @@map("roles_permissions")
}

model UserRole {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([role_id])
  @@map("users_roles")
}

model UserPermission {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id       String    @db.Uuid
  permission_id String    @db.Uuid
  is_active     Boolean?  @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([permission_id])
  @@map("users_permissions")
}

enum ContractStatus {
  PENDING
  ACTIVE
  OVERDUE_LEVEL_1
  OVERDUE_LEVEL_2
  OVERDUE_LEVEL_3
  SEALED
  LIQUIDATED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentType {
  NEW_CONTRACT
  RENEWAL
}

enum TemplateRentalStatus {
  AVAILABLE
  LOCKED
  RENTED
}

model WarehouseTemplate {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?

  length Int
  width  Int

  is_shared_warehouse Boolean @default(false)

  rental_status            TemplateRentalStatus @default(AVAILABLE)
  is_rented                Boolean              @default(false)
  price_per_month          Decimal              @db.Decimal(19, 4)
  discount_1_month         Decimal              @default(0) @db.Decimal(5, 2)
  discount_3_months        Decimal              @default(5) @db.Decimal(5, 2)
  discount_6_months        Decimal              @default(10) @db.Decimal(5, 2)
  discount_1_year          Decimal              @default(15) @db.Decimal(5, 2)
  discount_2_years         Decimal              @default(20) @db.Decimal(5, 2)
  discount_3_years_plus    Decimal              @default(25) @db.Decimal(5, 2)
  whole_warehouse_discount Decimal              @default(10) @db.Decimal(5, 2)

  address_detail String?
  ward_id        String? @db.Uuid
  ward           Ward?   @relation(fields: [ward_id], references: [id])

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  block_length Decimal @db.Decimal(10, 4)
  block_width  Decimal @db.Decimal(10, 4)

  manager_name  String?
  manager_phone String?
  manager_email String?

  ceiling_height    Decimal? @db.Decimal(10, 4)
  max_load_capacity Decimal? @db.Decimal(19, 4)

  is_cold_storage Boolean  @default(false)
  min_temperature Decimal? @db.Decimal(5, 2)
  max_temperature Decimal? @db.Decimal(5, 2)
  min_humidity    Decimal? @db.Decimal(5, 2)
  max_humidity    Decimal? @db.Decimal(5, 2)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  rows                    RowTemplate[]
  images                  WarehouseTemplateImage[]
  amenities               AmenityOnWarehouseTemplate[]
  rental_contract_details RentalContractDetail[]

  @@map("warehouse_templates")
}

model WarehouseTemplateImage {
  id                    String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  warehouse_template_id String  @db.Uuid
  url                   String
  thumbnail_url         String?
  file_id               String
  original_name         String?
  size                  Int?
  order                 Int     @default(0)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  deleted_by String?

  warehouse_template WarehouseTemplate @relation(fields: [warehouse_template_id], references: [id], onDelete: Cascade)

  @@index([warehouse_template_id])
  @@map("warehouse_template_images")
}

model RowTemplate {
  id                    String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  warehouse_template_id String  @db.Uuid
  name                  String
  code                  String
  description           String?

  is_rented             Boolean @default(false)
  price_per_month       Decimal @db.Decimal(19, 4)
  discount_1_month      Decimal @default(0) @db.Decimal(5, 2)
  discount_3_months     Decimal @default(5) @db.Decimal(5, 2)
  discount_6_months     Decimal @default(10) @db.Decimal(5, 2)
  discount_1_year       Decimal @default(15) @db.Decimal(5, 2)
  discount_2_years      Decimal @default(20) @db.Decimal(5, 2)
  discount_3_years_plus Decimal @default(25) @db.Decimal(5, 2)

  address   String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  position_x        Decimal? @db.Decimal(10, 4)
  position_y        Decimal? @db.Decimal(10, 4)
  position_rotation Decimal? @db.Decimal(10, 4)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  warehouse_template WarehouseTemplate @relation(fields: [warehouse_template_id], references: [id], onDelete: Cascade)
  racks              RackTemplate[]

  @@index([warehouse_template_id])
  @@map("row_templates")
}

model RackTemplate {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  row_template_id String  @db.Uuid
  name            String
  code            String
  description     String?

  position_x        Decimal? @db.Decimal(10, 4)
  position_y        Decimal? @db.Decimal(10, 4)
  position_rotation Decimal? @db.Decimal(10, 4)

  dimensions_width  Decimal? @db.Decimal(10, 4)
  dimensions_depth  Decimal? @db.Decimal(10, 4)
  dimensions_height Decimal? @db.Decimal(10, 4)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  row_template RowTemplate     @relation(fields: [row_template_id], references: [id], onDelete: Cascade)
  shelves      ShelfTemplate[]

  @@index([row_template_id])
  @@map("rack_templates")
}

model ShelfTemplate {
  id               String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  rack_template_id String  @db.Uuid
  name             String
  code             String
  description      String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  rack_template RackTemplate    @relation(fields: [rack_template_id], references: [id], onDelete: Cascade)
  blocks        BlockTemplate[]

  @@index([rack_template_id])
  @@map("shelf_templates")
}

model BlockTemplate {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  shelf_template_id String  @db.Uuid
  name              String
  code              String
  description       String?

  position_x Decimal? @db.Decimal(10, 4)
  position_y Decimal? @db.Decimal(10, 4)

  dimensions_width  Decimal? @db.Decimal(10, 4)
  dimensions_height Decimal? @db.Decimal(10, 4)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  shelf_template ShelfTemplate @relation(fields: [shelf_template_id], references: [id], onDelete: Cascade)

  @@index([shelf_template_id])
  @@map("block_templates")
}

model RentalContract {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_id String         @db.Uuid
  code            String
  name            String?
  status          ContractStatus @default(PENDING)

  started_at         DateTime
  expired_at         DateTime?
  actual_ended_at    DateTime?
  overdue_level_1_at DateTime?
  overdue_level_2_at DateTime?
  overdue_level_3_at DateTime?

  is_sealed     Boolean @default(false)
  is_liquidated Boolean @default(false)

  total_price             Decimal  @db.Decimal(19, 4)
  discount_rate           Decimal  @default(0) @db.Decimal(5, 2)
  final_price             Decimal  @db.Decimal(19, 4)
  overdue_penalty         Decimal? @default(0) @db.Decimal(19, 4)
  overdue_penalty_percent Decimal? @default(0) @db.Decimal(5, 2)

  notes String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  details      RentalContractDetail[]
  payments     Payment[]

  @@index([organization_id])
  @@map("rental_contracts")
}

model RentalContractDetail {
  id                 String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  rental_contract_id String @db.Uuid

  warehouse_template_id String   @db.Uuid
  warehouse_name        String
  warehouse_description String?
  row_template_ids      String[] @default([])
  is_whole_warehouse    Boolean  @default(true)
  warehouse_id          String?  @db.Uuid
  row_id                String?  @db.Uuid

  price_per_month Decimal @db.Decimal(19, 4)
  discount_rate   Decimal @default(0) @db.Decimal(5, 2)
  rental_days     Int
  subtotal        Decimal @db.Decimal(19, 4)

  notes String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  rental_contract    RentalContract    @relation(fields: [rental_contract_id], references: [id], onDelete: Cascade)
  warehouse_template WarehouseTemplate @relation(fields: [warehouse_template_id], references: [id])
  warehouse          Warehouse?        @relation(fields: [warehouse_id], references: [id])
  row                Row?              @relation(fields: [row_id], references: [id])

  @@index([rental_contract_id])
  @@index([warehouse_template_id])
  @@index([warehouse_id])
  @@index([row_id])
  @@map("rental_contract_details")
}

model Payment {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  rental_contract_id   String        @db.Uuid
  payment_code         String        @unique
  sepay_transaction_id BigInt?       @unique
  amount               Int
  description          String
  type                 PaymentType
  status               PaymentStatus @default(PENDING)

  qr_code String? @db.Text

  expired_at DateTime?
  paid_at    DateTime?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean?  @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?

  rental_contract RentalContract @relation(fields: [rental_contract_id], references: [id], onDelete: Cascade)

  @@index([rental_contract_id])
  @@index([payment_code])
  @@index([status])
  @@map("payments")
}

model Organization {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name       String
  is_active  Boolean? @default(true)
  is_deleted Boolean? @default(false)
  owner_id   String   @db.Uuid

  google_client_id      String? @db.Text
  google_client_secret  String? @db.Text
  google_refresh_token  String? @db.Text
  email_primary_address String?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  api_keys ApiKey[]

  owner User @relation("OwnerRelation", fields: [owner_id], references: [id], onDelete: Cascade)

  members    OrganizationMember[]
  roles      OrganizationRole[]
  partners   Partner[]
  products   Product[]
  units      Unit[]
  warehouses Warehouse[]

  rental_contracts       RentalContract[]
  inventory_transactions InventoryTransaction[]
  inventories            Inventory[]
  audit_logs             OrganizationAuditLog[]
  api_key_logs           ApiKeyLog[]
  notifications          OrganizationNotification[]

  @@map("organizations")
}

model OrganizationMember {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id         String   @db.Uuid
  organization_id String   @db.Uuid
  is_accepted     Boolean? @default(false)
  is_active       Boolean? @default(true)
  is_deleted      Boolean? @default(false)

  invite_token            String?   @unique
  invite_token_expires_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  created_by String
  updated_by String?
  deleted_by String?

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  roles       OrganizationMemberRole[]
  permissions OrganizationMemberPermission[]

  @@index([user_id])
  @@index([organization_id])
  @@index([invite_token])
  @@map("organizations_members")
}

model OrganizationRole {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name            String
  description     String?
  is_active       Boolean? @default(true)
  organization_id String   @db.Uuid

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  is_default Boolean @default(false)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  api_key_assignments ApiKeyRole[]

  permissions OrganizationRolePermission[]
  members     OrganizationMemberRole[]

  @@map("organizations_roles")
}

model OrganizationPermission {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  key         String
  is_active   Boolean? @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  roles OrganizationRolePermission[]

  api_key_assignments ApiKeyPermission[]
  members             OrganizationMemberPermission[]

  @@map("organizations_permissions")
}

model OrganizationRolePermission {
  id                         String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_role_id       String   @db.Uuid
  organization_permission_id String   @db.Uuid
  is_active                  Boolean? @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  role       OrganizationRole       @relation(fields: [organization_role_id], references: [id], onDelete: Cascade)
  permission OrganizationPermission @relation(fields: [organization_permission_id], references: [id], onDelete: Cascade)

  @@index([organization_role_id])
  @@index([organization_permission_id])
  @@map("organizations_roles_permissions")
}

model OrganizationMemberRole {
  id                     String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_member_id String   @db.Uuid
  organization_role_id   String   @db.Uuid
  warehouse_id           String?  @db.Uuid
  is_active              Boolean? @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  member    OrganizationMember @relation(fields: [organization_member_id], references: [id], onDelete: Cascade)
  role      OrganizationRole   @relation(fields: [organization_role_id], references: [id], onDelete: Cascade)
  warehouse Warehouse?         @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@index([organization_member_id])
  @@index([organization_role_id])
  @@index([warehouse_id])
  @@map("organizations_members_roles")
}

model OrganizationMemberPermission {
  id                         String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_member_id     String    @db.Uuid
  organization_permission_id String    @db.Uuid
  warehouse_id               String?   @db.Uuid
  is_active                  Boolean?  @default(true)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  is_deleted                 Boolean   @default(false)
  deleted_at                 DateTime?

  member     OrganizationMember     @relation(fields: [organization_member_id], references: [id], onDelete: Cascade)
  permission OrganizationPermission @relation(fields: [organization_permission_id], references: [id], onDelete: Cascade)
  warehouse  Warehouse?             @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@index([organization_member_id])
  @@index([organization_permission_id])
  @@index([warehouse_id])
  @@map("organizations_members_permissions")
}

model ApiKey {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name         String
  description  String?
  key_prefix   String
  key_hash     String    @unique
  is_active    Boolean   @default(true)
  expires_at   DateTime?
  last_used_at DateTime?
  last_used_ip String?

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  created_by_user_id String  @db.Uuid
  created_by         User    @relation(fields: [created_by_user_id], references: [id])
  updated_by         String?
  is_deleted         Boolean @default(false)
  deleted_by         String?

  roles       ApiKeyRole[]
  permissions ApiKeyPermission[]

  audit_logs   OrganizationAuditLog[]
