  match_type ContactListMatchType
  value      String

  country_code String?
  city_code    String?

  reason String?
  notes  String? @db.Text

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  @@unique([list_type, match_type, value])
  @@index([list_type])
  @@index([match_type])
  @@index([value])
  @@index([is_active])
  @@map("contact_list_entries")
}

enum ContactActionType {
  CLOSE
  REOPEN
  DELETE
  ADD_WHITELIST
  REMOVE_WHITELIST
  ADD_BLACKLIST
  REMOVE_BLACKLIST
  SET_PRIORITY
  SET_SKIP
  UNSET_SKIP
}

enum ContactActionPerformedByType {
  SYSTEM
  ADMIN
  STAFF
  DISCORD
}

model ContactActionLog {
  id              String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  conversation_id String @db.Uuid

  action_type ContactActionType
  reason      String?           @db.Text

  list_type    String?
  match_type   String?
  match_value  String?
  priority     String?
  old_status   String?
  new_status   String?

  performed_by_id   String?                      @db.Uuid
  performed_by_name String?
  performed_by_type ContactActionPerformedByType @default(SYSTEM)

  created_at DateTime @default(now())

  conversation ContactConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([action_type])
  @@index([created_at])
  @@map("contact_action_logs")
}

enum ChatCallType {
  VOICE
  VIDEO
}

enum ChatCallStatus {
  WAITING
  ONGOING
  ENDED
}

model OrganizationChatMessage {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_id String   @db.Uuid
  content         String   @db.Text

  agora_message_id String?

  call_id String? @db.Uuid

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  created_by String?  @db.Uuid
  deleted_by String? @db.Uuid

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  call         OrganizationChatCall? @relation(fields: [call_id], references: [id])

  @@unique([organization_id, agora_message_id])
  @@index([organization_id])
  @@index([created_at])
  @@map("organization_chat_messages")
}

model OrganizationChatCall {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  organization_id String         @db.Uuid
  call_type       ChatCallType
  status          ChatCallStatus @default(WAITING)

  agora_channel_name String

  started_at DateTime?
  ended_at   DateTime?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  created_by String?  @db.Uuid
  ended_by   String? @db.Uuid

  organization Organization                      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  participants OrganizationChatCallParticipant[]
  messages     OrganizationChatMessage[]

  @@index([organization_id])
  @@index([status])
  @@map("organization_chat_calls")
}

model OrganizationChatCallParticipant {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  call_id String @db.Uuid
  user_id String @db.Uuid

  agora_uid Int

  joined_at DateTime  @default(now())
  left_at   DateTime?

  is_active Boolean @default(true)

  call OrganizationChatCall @relation(fields: [call_id], references: [id], onDelete: Cascade)

  @@unique([call_id, user_id])
  @@index([call_id])
  @@index([user_id])
  @@map("organization_chat_call_participants")
}

enum BackupType {
  SCHEDULED
  MANUAL_API
  MANUAL_DISCORD
}

model DatabaseBackup {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  file_name        String
  file_size        BigInt
  drive_file_id    String
  drive_file_url   String?    @db.Text
  backup_type      BackupType @default(SCHEDULED)
  compression_type String     @default("zip")

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  triggered_by String?

  @@index([created_at])
  @@index([backup_type])
  @@map("database_backups")
}

model WarningCategory {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  name        String
  description String?
  severity    Int     @default(1)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  warnings UserWarning[]

  @@map("warning_categories")
}

model UserWarning {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  user_id     String  @db.Uuid
  category_id String  @db.Uuid
  reason      String  @db.Text

  is_permanent Boolean   @default(false)
  expires_at   DateTime?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  warned_by  String    @db.Uuid
  removed_by String?   @db.Uuid
  removed_at DateTime?

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category WarningCategory @relation(fields: [category_id], references: [id])

  @@index([user_id])
  @@index([category_id])
  @@map("user_warnings")
}

model WarnPenalty {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  min_warn_count  Int
  max_warn_count  Int?
  
  is_permanent_ban Boolean         @default(false)
  duration_value   Int?
  duration_unit    BanDurationUnit?
  
  description     String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  created_by String?
  updated_by String?
  deleted_by String?

  @@map("warn_penalties")
}

model AppDownloadShare {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  token            String    @unique
  max_download     Int       @default(-1)
  current_download Int       @default(0)
  is_permanent     Boolean   @default(false)
  expires_at       DateTime?
  
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  
  created_by String?
  deleted_by String?
  
  invites AppDownloadInvite[]
  
  @@map("app_download_shares")
}

model AppDownloadInvite {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid
  share_id String @db.Uuid
  email    String
  
  email_sent_at    DateTime?
  email_sent_count Int       @default(0)
  
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  
  created_by String?
  deleted_by String?
  
  share AppDownloadShare @relation(fields: [share_id], references: [id], onDelete: Cascade)
  
  @@index([share_id])
  @@index([email])
  @@map("app_download_invites")
}
