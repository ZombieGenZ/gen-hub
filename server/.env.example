# Server Configuration
PORT=4000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=https://gen-hub.dev,http://localhost:3000

# Backend URL
BACKEND_URL=https://api.gen-hub.dev

# Database Configuration
DATABASE_URL=your_database_url

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Redis Configuration
REDIS_URL=your_redis_url

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ACCESS_VERIFICATION_TOKEN_SECRET=your_access_verification_token_secret_here
ACCESS_VERIFICATION_TOKEN_EXPIRATION=5m
TEMP_2FA_TOKEN_SECRET=your_temp_2fa_token_secret_here
TEMP_2FA_TOKEN_EXPIRATION=5m

# Security Configuration
# Argon2id Password Hashing Configuration
# memoryCost: Memory usage in KiB (64 MB = 65536 KiB)
ARGON2_MEMORY_COST=65536
# timeCost: Number of iterations
ARGON2_TIME_COST=3
# parallelism: Number of parallel threads
ARGON2_PARALLELISM=1

EMAIL_VERIFY_EXPIRATION=86400000
FORGOT_PASSWORD_EXPIRATION=900000
# Secret key for AES-256 encryption of sensitive data
CIPHER_SECRET_KEY=your_secure_random_string_here

# Email Configuration (Gmail SMTP)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
EMAIL_PRIMARY_ADDRESS=your_email@gmail.com
EMAIL_SEND_ADDRESS=no-reply@your-domain.com
EMAIL_SUPPORT_ADDRESS=support@your-domain.com

# Gmail API Configuration
# Push notifications via Pub/Sub (recommended)
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project-id/subscriptions/gmail-push-sub
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_WATCH_RENEW_INTERVAL_HOURS=24
GMAIL_WEBHOOK_SECRET=your-random-webhook-secret

# Gmail API Polling mode (fallback when Pub/Sub is not available)
# Set GMAIL_USE_POLLING=true to enable polling instead of push notifications
GMAIL_USE_POLLING=false
GMAIL_POLL_INTERVAL_SECONDS=30

# API Key Configuration
API_KEY_PREFIX=GENHUB
API_KEY_RATE_LIMIT_TTL=60
API_KEY_RATE_LIMIT_MAX=100

# Support Configuration
SUPPORT_EMAIL=support@gen-hub.dev
SUPPORT_PHONE=0999 999 999

# Branding Configuration (Defaults for app-config.json)
BRAND_NAME=GEN-HUB

# Primary Colors
COLOR_PRIMARY=#0F766E
COLOR_PRIMARY_LIGHT=#14B8A6
COLOR_PRIMARY_DARK=#0D5A52

# Neutral / Greys
COLOR_GRAY_900=#1E293B
COLOR_GRAY_700=#334155
COLOR_GRAY_500=#64748B
COLOR_GRAY_300=#CBD5E1
COLOR_GRAY_100=#F1F5F9

# Background & Surface
COLOR_BACKGROUND=#F8FAFC
COLOR_CARD_SURFACE=#FFFFFF
COLOR_SIDEBAR_BG=#F1F5F9

# Accent Colors
COLOR_SUCCESS=#10B981
COLOR_WARNING=#F59E0B
COLOR_ERROR=#EF4444
COLOR_INFO=#0EA5E9

# Border + Shadow
COLOR_BORDER=#E2E8F0
COLOR_SHADOW=rgba(0, 0, 0, 0.04)

# Pagination Configuration (default values when user doesnt pass limit/offset)
DEFAULT_LIMIT=10
DEFAULT_OFFSET=0
MAX_LIMIT=1000
MIN_LIMIT=1

# AI Auto-Reply Configuration
ENABLE_AI_AUTO_REPLY=true

# Redis Cache TTL Configuration (in seconds)
REDIS_USER_CACHE_TTL=300
REDIS_PERMISSION_CACHE_TTL=300
REDIS_WAREHOUSE_TEMPLATE_CACHE_TTL=300
REDIS_WAREHOUSE_TEMPLATE_LIST_CACHE_TTL=300
REDIS_ORGANIZATION_CACHE_TTL=300
REDIS_ORGANIZATION_LIST_CACHE_TTL=60
REDIS_ORGANIZATION_MEMBER_CACHE_TTL=300
REDIS_GLOBAL_NOTIFICATION_CACHE_TTL=300
REDIS_GLOBAL_NOTIFICATION_LIST_CACHE_TTL=60
REDIS_USER_NOTIFICATION_CACHE_TTL=300
REDIS_USER_NOTIFICATION_LIST_CACHE_TTL=60
REDIS_ORG_NOTIFICATION_CACHE_TTL=300
REDIS_ORG_NOTIFICATION_LIST_CACHE_TTL=60
REDIS_WAREHOUSE_CACHE_TTL=300
REDIS_WAREHOUSE_LIST_CACHE_TTL=60
REDIS_RENTAL_CONTRACT_CACHE_TTL=300
REDIS_RENTAL_CONTRACT_LIST_CACHE_TTL=60
REDIS_AMENITY_CACHE_TTL=300
REDIS_AMENITY_LIST_CACHE_TTL=60
REDIS_PROVINCE_LIST_TTL=86400
REDIS_PROVINCE_DETAIL_TTL=86400
REDIS_WARD_LIST_TTL=86400
REDIS_WARD_DETAIL_TTL=86400
REDIS_PARTNER_LIST_TTL=300
REDIS_PARTNER_DETAIL_TTL=600
REDIS_PRODUCT_LIST_TTL=300
REDIS_PRODUCT_DETAIL_TTL=600
REDIS_BATCH_LIST_TTL=300
REDIS_BATCH_DETAIL_TTL=600
REDIS_RENTAL_DURATION_TIER_CACHE_TTL=300
REDIS_RENTAL_DURATION_TIER_LIST_CACHE_TTL=60
REDIS_ROW_TEMPLATE_CACHE_TTL=300
REDIS_ROW_TEMPLATE_LIST_CACHE_TTL=60
REDIS_RACK_TEMPLATE_CACHE_TTL=300
REDIS_RACK_TEMPLATE_LIST_CACHE_TTL=60
REDIS_SHELF_TEMPLATE_CACHE_TTL=300
REDIS_SHELF_TEMPLATE_LIST_CACHE_TTL=60
REDIS_BLOCK_TEMPLATE_CACHE_TTL=300
REDIS_BLOCK_TEMPLATE_LIST_CACHE_TTL=60
REDIS_ADDON_CACHE_TTL=300
REDIS_ADDON_LIST_CACHE_TTL=60
REDIS_INSURANCE_CACHE_TTL=300
REDIS_INSURANCE_LIST_CACHE_TTL=60
REDIS_COUPON_CACHE_TTL=300
REDIS_COUPON_LIST_CACHE_TTL=60
REDIS_COUPON_SCHEDULE_CACHE_TTL=300
REDIS_COUPON_SCHEDULE_LIST_CACHE_TTL=60
REDIS_ACCOUNT_BALANCE_CACHE_TTL=300
REDIS_BALANCE_TRANSACTION_LIST_CACHE_TTL=60
REDIS_ADDON_TYPE_CACHE_TTL=300
REDIS_ADDON_TYPE_LIST_CACHE_TTL=60
REDIS_FAQ_CACHE_TTL=300
REDIS_FAQ_LIST_CACHE_TTL=60
REDIS_CONTACT_CACHE_TTL=300
REDIS_CONTACT_LIST_CACHE_TTL=60
REDIS_CATEGORY_CACHE_TTL=300
REDIS_CATEGORY_LIST_CACHE_TTL=60
REDIS_ARTICLE_CACHE_TTL=300
REDIS_ARTICLE_LIST_CACHE_TTL=60
REDIS_ARTICLE_EMOJI_CACHE_TTL=3600
REDIS_ARTICLE_COMMENT_CACHE_TTL=60
REDIS_QC_WAREHOUSE_CACHE_TTL=300
REDIS_QC_ROW_CACHE_TTL=300
REDIS_QC_RACK_CACHE_TTL=300
REDIS_QC_SHELF_CACHE_TTL=300
REDIS_QC_BLOCK_CACHE_TTL=300
REDIS_QC_PERMISSION_CACHE_TTL=300
REDIS_CONTRACT_INSURANCE_CACHE_TTL=300
REDIS_REFUND_REQUEST_CACHE_TTL=300
REDIS_REFUND_REQUEST_LIST_CACHE_TTL=60
REDIS_LIVE_CHAT_SESSION_CACHE_TTL=3600
REDIS_COZE_PRICING_TTL=300
REDIS_COZE_AVAILABILITY_TTL=60
REDIS_COZE_TERMS_TTL=86400
REDIS_COZE_FAQ_TTL=300
REDIS_CONTACT_LIST_CACHE_TTL=3600
REDIS_CONTACT_LIST_LIST_CACHE_TTL=300
REDIS_ORG_CHAT_MESSAGE_LIST_CACHE_TTL=60
REDIS_BACKUP_CACHE_TTL=300
REDIS_BACKUP_LIST_CACHE_TTL=60

# Contact Ticket Configuration
CONTACT_TICKET_PREFIX=TICKET

# Article Comment Configuration
# Tự động chấp thuận comment khi tạo (true = chấp thuận, false = cần duyệt)
AUTO_APPROVE_COMMENTS=true

# Code Affix Configuration (cho CouponSchedule)
CODE_WEEK_PREFIX=W
CODE_MONTH_PREFIX=M
CODE_QUARTER_PREFIX=P

# User Online Status Configuration
USER_ONLINE_TIMEOUT_SECONDS=60
USER_ONLINE_CHECK_INTERVAL_MS=30000

# Payment Configuration
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_HOLDER=your_account_holder_name
SEPAY_API_KEY="your_sepay_api_key_here"
PAYMENT_CODE_PREFIX=GENHUB
PAYMENT_CODE_LENGTH=8
CONTRACT_PENDING_EXPIRE_HOURS=24

# ImageKit Configuration (for image upload)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Watermark Configuration
WATERMARK_ENABLED=true
WATERMARK_PATH=./assets/watermark.png
WATERMARK_POSITION=northeast
WATERMARK_OPACITY=0.5

# Rental Contract Configuration
RENTAL_LOCK_DURATION_HOURS=1
RENTAL_MAX_PENDING_PER_USER=3
RENTAL_CONTRACT_PREFIX=GENHUB
RENTAL_EXPIRY_WARNING_DAYS=7
# Số ngày tối đa có thể delay ngày bắt đầu thuê so với ngày thanh toán
RENTAL_MAX_DELAYED_START_DAYS=14

# Overdue Level Configuration (days after contract expiry)
OVERDUE_LEVEL_1_DAYS=15
OVERDUE_LEVEL_2_DAYS=30
OVERDUE_LEVEL_3_DAYS=45
OVERDUE_SEALED_DAYS=60
OVERDUE_PENALTY_PERCENT=5

# Contract Cancellation Fee
CONTRACT_CANCEL_FEE_PERCENT=10

# Language Configuration
ALLOWED_LANGUAGES=vi,en

# Upload Configuration
UPLOAD_AVATAR_MAX_SIZE=2097152
UPLOAD_AVATAR_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_WAREHOUSE_MAX_SIZE=5242880
UPLOAD_WAREHOUSE_MAX_FILES=50
UPLOAD_WAREHOUSE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# Database Panel CORS
DATABASE_ADMIN_CORS_ORIGIN=http://localhost:3001

# Log Rotation Configuration
# Auto-delete old logs to prevent database bloat
AUTO_DELETE_SYSTEM_LOGS=true
AUTO_DELETE_DATABASE_LOGS=true
AUTO_DELETE_FEATURE_FLAG_LOGS=true
# Retention period in milliseconds (default: 30 days = 2592000000ms)
SYSTEM_LOGS_RETENTION_MS=2592000000
DATABASE_LOGS_RETENTION_MS=2592000000
FEATURE_FLAG_LOGS_RETENTION_MS=2592000000

# Resources Monitoring Configuration
# Service Metrics URLs (for Resources Panel monitoring)
RESOURCES_SERVER_URL=http://localhost:4000/health
RESOURCES_CLIENT_URL=http://localhost:3000/api/metrics
RESOURCES_DATABASE_PANEL_URL=http://localhost:3600/api/metrics
RESOURCES_FEATURE_FLAG_PANEL_URL=http://localhost:3700/api/metrics
RESOURCES_STATUS_URL=http://localhost:3500/api/metrics
RESOURCES_RESOURCES_PANEL_URL=http://localhost:3800/api/metrics

# API Keys for each service (generate secure random strings)
RESOURCES_API_KEY_SERVER=your_server_api_key_here
RESOURCES_API_KEY_CLIENT=your_client_api_key_here
RESOURCES_API_KEY_DATABASE_PANEL=your_database_panel_api_key_here
RESOURCES_API_KEY_FEATURE_FLAG_PANEL=your_feature_flag_panel_api_key_here
RESOURCES_API_KEY_STATUS=your_status_api_key_here
RESOURCES_API_KEY_RESOURCES_PANEL=your_resources_panel_api_key_here

# Broadcast interval in milliseconds (default: 5000 = 5 seconds)
RESOURCES_BROADCAST_INTERVAL_MS=1000

# Cloudflare Turnstile Captcha
# Set to true to enable captcha verification on auth endpoints
# Set to false to skip captcha verification (for development)
USE_CLOUDFLARE_CAPTCHA=false
CLOUDFLARE_TURNSTILE_SECRETKEY=your_turnstile_secret_key

# Cloudflare Analytics API
CLOUDFLARE_EMAIL=your_cloudflare_email@example.com
CLOUDFLARE_API_KEY=your_cloudflare_global_api_key
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_START_ANALYTICS_DATE=2024-01-01

# Hunter.io Email Verification
# Set to true to verify email deliverability during registration
USE_HUNTER_EMAIL_VERIFICATION=false
HUNTER_API_KEY=your_hunter_api_key

# Brute Force Protection Configuration
# Comma-separated list of whitelisted IPs (these IPs bypass brute force checks)
IP_WHITELIST=127.0.0.1,::1
# JSON config for penalty rules: {attempts: lockMinutes} (-1 = permanent ban)
PENALTY_RULES={"5":10,"6":15,"7":30,"8":60,"16":-1}
# TTL in seconds for unlock codes (default: 15 minutes)
BRUTE_FORCE_UNLOCK_CODE_TTL=900
# Maximum failed attempts before permanent ban (updates is_banned = true in DB)
BRUTE_FORCE_PERMANENT_BAN_THRESHOLD=16

# Deposit Payment Configuration
DEPOSIT_MIN_AMOUNT=10000
DEPOSIT_MAX_AMOUNT=100000000
DEPOSIT_PAYMENT_EXPIRE_MINUTES=10

# DatabaseLog Auto-logging Configuration
DATABASE_LOG_ENABLED=true
DATABASE_LOG_EXCLUDED_TABLES=database_logs,system_logs,refresh_tokens,backup_codes,api_key_logs,organization_audit_logs,feature_flag_logs,ai_logs
DATABASE_LOG_ASYNC=true
DATABASE_LOG_BATCH_SIZE=100
DATABASE_LOG_FLUSH_INTERVAL_MS=5000

# Gemini AI Configuration
# Supports multiple API keys (separated by commas) for rotation when quotas are exhausted.
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-1.5-flash

# Discord Integration (Optional)
# Set to true to enable Discord integration for support tickets
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_PRIORITY_CATEGORY_ID=your_priority_category_id
DISCORD_SUPPORT_CATEGORY_ID=your_support_category_id
CONTACT_IGNORED_CATEGORY_ID=your_ignored_category_id
DISCORD_CLOSED_CATEGORY_ID=your_closed_category_id
# List of Discord role IDs for staff members (to reply to tickets)
DISCORD_STAFF_REPLY_ROLE_IDS=your_discord_role_ids
# Comma-separated list of Discord channel IDs for auto-support with Coze AI
DISCORD_AUTO_SUPPORT_CHANNEL_IDS=your_discord_channel_ids

# Coze AI Configuration (for Live Chat auto-reply)
COZE_ENABLED=false
COZE_API_KEY=your_coze_api_key
COZE_BOT_ID=your_coze_bot_id
COZE_API_BASE_URL=https://api.coze.com

# Coze Plugin API Key (for Coze bot to access GEN-HUB APIs)
# Generate a secure random string: openssl rand -hex 32
COZE_PLUGIN_API_KEY=your_secure_random_api_key_here

# Get credentials from https://console.agora.io
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_TOKEN_EXPIRATION_SECONDS=3600

# Backblaze B2 Configuration (S3-compatible storage for backups)
# See documents/environment/13-backblaze-b2-setup-guide.md for setup instructions
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_ENDPOINT=your_b2_endpoint
B2_BUCKET_NAME=your_bucket_name
# Friendly URL format: https://f004.backblazeb2.com/file/<bucket_name>
B2_FRIENDLY_URL=https://f004.backblazeb2.com/file/your_bucket_name

# Backup Schedule Configuration
# Interval in seconds (default: 86400 = 24 hours)
BACKUP_INTERVAL_SECONDS=86400
# Maximum number of backups to keep (oldest will be deleted when exceeded)
BACKUP_MAX_COUNT=30
# Compression type: zip (recommended, no external binary needed)
BACKUP_COMPRESSION_TYPE=zip
# Password for backup archive (required)
BACKUP_PASSWORD=your_secure_backup_password

# Backup Secret Key (required for API/Discord trigger)
BACKUP_SECRET_KEY=your_secure_random_key

# Backup folder name trên Backblaze B2
BACKUP_FOLDER_NAME=backups

# Backup Download URL TTL (ms) - thời gian hết hạn của URL tải backup
# Mặc định: 600000 (10 phút)
BACKUP_DOWNLOAD_URL_TTL_MS=600000

# Discord Backup Integration
DISCORD_BACKUP_CHANNEL_ID=your_discord_backup_channel_id
# Comma-separated role IDs that can execute backup commands
DISCORD_BACKUP_ROLE_IDS=role_id_1,role_id_2
