# Database Configuration
DATABASE_URL="YOUR_DATABASE_URL"

# Server Configuration
PORT=4000
NODE_ENV='development'
TZ='Asia/Ho_Chi_Minh'

# JWT Configuration
JWT_ACCESS_SECRET="YOUR_ACCESS_SECRET"
JWT_REFRESH_SECRET="YOUR_REFRESH_SECRET"
JWT_ACCESS_EXPIRATION='15m'
JWT_REFRESH_EXPIRATION='7d'
ACCESS_VERIFICATION_TOKEN_SECRET="VERIFY_SECRET"
ACCESS_VERIFICATION_TOKEN_EXPIRATION='5m'
TEMP_2FA_TOKEN_SECRET="TEMP_2FA_SECRET"
TEMP_2FA_TOKEN_EXPIRATION='5m'

# Email Configuration (Google OAuth2)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"
EMAIL_PRIMARY_ADDRESS="your-primary-email@gmail.com"
EMAIL_SEND_ADDRESS="your-send-email@gmail.com"

# Frontend URL
FRONTEND_URL="https://domain.com"

# Security Configuration
SALT_ROUNDS=12
EMAIL_VERIFY_EXPIRATION=86400000
FORGOT_PASSWORD_EXPIRATION=900000

# Branding Configuration (Defaults for app-config.json)
BRAND_NAME='GEN-HUB'

# Primary Colors
COLOR_PRIMARY='#0F766E'
COLOR_PRIMARY_LIGHT='#14B8A6'
COLOR_PRIMARY_DARK='#0D5A52'

# Neutral / Greys
COLOR_GRAY_900='#1E293B'
COLOR_GRAY_700='#334155'
COLOR_GRAY_500='#64748B'
COLOR_GRAY_300='#CBD5E1'
COLOR_GRAY_100='#F1F5F9'

# Background & Surface
COLOR_BACKGROUND='#F8FAFC'
COLOR_CARD_SURFACE='#FFFFFF'
COLOR_SIDEBAR_BG='#F1F5F9'

# Accent Colors
COLOR_SUCCESS='#10B981'
COLOR_WARNING='#F59E0B'
COLOR_ERROR='#EF4444'
COLOR_INFO='#0EA5E9'

# Border + Shadow
COLOR_BORDER='#E2E8F0'
COLOR_SHADOW='rgba(0, 0, 0, 0.04)'

# Redis Configuration
REDIS_URL="redis://default:password@your-redis-host:6379"
# Hoặc cấu hình riêng lẻ (nếu không dùng REDIS_URL)
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Redis Cache TTL Configuration (in seconds)
REDIS_USER_CACHE_TTL=300
REDIS_PERMISSION_CACHE_TTL=300
REDIS_WAREHOUSE_TEMPLATE_CACHE_TTL=300
REDIS_WAREHOUSE_TEMPLATE_LIST_CACHE_TTL=60
REDIS_ORGANIZATION_CACHE_TTL=300
REDIS_ORGANIZATION_LIST_CACHE_TTL=60
REDIS_ORGANIZATION_MEMBER_CACHE_TTL=300