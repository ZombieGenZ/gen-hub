# Database Configuration
DATABASE_URL="YOUR_DATABASE_URL"

# Server Configuration
PORT=4000
NODE_ENV='development'
TZ='Asia/Ho_Chi_Minh'

# JWT Configuration
JWT_ACCESS_SECRET="YOUR_ACCESS_SECRET"
JWT_REFRESH_SECRET="YOUR_REFRESH_SECRET"
JWT_ACCESS_EXPIRATION='15m'
JWT_REFRESH_EXPIRATION='7d'
ACCESS_VERIFICATION_TOKEN_SECRET="VERIFY_SECRET"
ACCESS_VERIFICATION_TOKEN_EXPIRATION='5m'
TEMP_2FA_TOKEN_SECRET="TEMP_2FA_SECRET"
TEMP_2FA_TOKEN_EXPIRATION='5m'

# Email Configuration (Google OAuth2)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"
EMAIL_PRIMARY_ADDRESS="your-primary-email@gmail.com"
EMAIL_SEND_ADDRESS="your-send-email@gmail.com"

# Facebook OAuth Login
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# Frontend URL
FRONTEND_URL="https://domain.com"

# Security Configuration
SALT_ROUNDS=12
EMAIL_VERIFY_EXPIRATION=86400000
FORGOT_PASSWORD_EXPIRATION=900000

# App Configuration (Defaults for app-config.json)
APP_NAME='GEN-HUB'
APP_VERSION="1.0.0"
APP_TEAM_NAME='TANK ZENITH GEN Development Team'
APP_COPYRIGHT='© 2025 TANK ZENITH GEN. All rights reserved.'

# Redis Configuration
REDIS_URL="redis://default:password@your-redis-host:6379"
# Hoặc cấu hình riêng lẻ (nếu không dùng REDIS_URL)
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Redis Cache TTL Configuration (in seconds)
REDIS_USER_CACHE_TTL=300
REDIS_PERMISSION_CACHE_TTL=300
REDIS_WAREHOUSE_TEMPLATE_CACHE_TTL=300
REDIS_WAREHOUSE_TEMPLATE_LIST_CACHE_TTL=60