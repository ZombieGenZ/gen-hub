# API Configuration
# Local development
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Production
NEXT_PUBLIC_API_URL=https://api.gen-hub.dev

# Cookie config
NEXT_PUBLIC_ACCESS_TOKEN_KEY=access_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=refresh_token
NEXT_PUBLIC_VERIFICATION_TOKEN_KEY=access_verification_token
NEXT_PUBLIC_THEME_KEY=auth-theme

NEXT_PUBLIC_JWT_ACCESS_EXPIRATION=0.0104
NEXT_PUBLIC_JWT_REFRESH_EXPIRATION=7
NEXT_PUBLIC_ACCESS_VERIFICATION_TOKEN_EXPIRATION=0.00347

# Resources Monitoring API Key
RESOURCES_API_KEY=your_client_api_key_here

# Cloudflare Turnstile (Captcha)
NEXT_PUBLIC_USE_CLOUDFLARE_CAPTCHA=false
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITEKEY=your_turnstile_site_key

# MAPBOX (Map)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Live Chat
NEXT_PUBLIC_CHAT_UID_KEY=genhub_chat_uid
NEXT_PUBLIC_CHAT_SESSION_KEY=genhub_chat_session
NEXT_PUBLIC_CHAT_AUTO_START_DELAY=10000

# Chatbot Provider: "api" | "coze" | "dify" (default: coze)
NEXT_PUBLIC_CHATBOT_PROVIDER=coze

# Coze AI Chatbot (required when CHATBOT_PROVIDER=coze)
NEXT_PUBLIC_COZE_BOT_ID=your_coze_bot_id
NEXT_PUBLIC_COZE_BASE_URL=https://api.coze.com
# Optional: custom title
NEXT_PUBLIC_COZE_TITLE=GEN-HUB AI

# Dify AI Chatbot (required when CHATBOT_PROVIDER=dify)
NEXT_PUBLIC_DIFY_TOKEN=your_dify_app_token
NEXT_PUBLIC_DIFY_BASE_URL=https://api.dify.ai/v1
# Optional: custom title
NEXT_PUBLIC_DIFY_TITLE=GEN-HUB AI
