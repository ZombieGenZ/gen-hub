<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deep Teal – Slate Dark Theme -->
    
    <!-- Primary Colors -->
    <Color x:Key="PrimaryColor">#14B8A6</Color>
    <Color x:Key="PrimaryLightColor">#2DD4BF</Color>
    <Color x:Key="PrimaryDarkColor">#0F766E</Color>
    
    <!-- Neutral / Greys (inverted for dark) -->
    <Color x:Key="Gray900">#F1F5F9</Color>
    <Color x:Key="Gray700">#CBD5E1</Color>
    <Color x:Key="Gray500">#94A3B8</Color>
    <Color x:Key="Gray300">#475569</Color>
    <Color x:Key="Gray100">#1E293B</Color>
    
    <!-- Background & Surface -->
    <Color x:Key="BackgroundColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#1E293B</Color>
    <Color x:Key="SidebarBgColor">#1E293B</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="InfoColor">#0EA5E9</Color>
    
    <!-- Border & Shadow -->
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="ShadowColor">#40000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Gray300}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <!-- Input Background -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource PrimaryColor}"/>
    
    <!-- Button Backgrounds -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="ButtonSecondaryTextBrush" Color="{StaticResource Gray700}"/>

    <!-- Card Shadow -->
    <DropShadowEffect x:Key="CardShadow" 
                      Color="{StaticResource ShadowColor}" 
                      BlurRadius="12" 
                      ShadowDepth="4" 
                      Direction="270" 
                      Opacity="0.3"/>

    <!-- Sidebar Menu Item -->
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="MenuItemActiveBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="MenuItemActiveTextBrush" Color="{StaticResource PrimaryLightColor}"/>

</ResourceDictionary>
